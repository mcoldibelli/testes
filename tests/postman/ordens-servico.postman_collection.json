      "name": "API-08 Abrir OS CRITICA para o cliente criado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "const o = pm.response.json();",
              "pm.test(\"status inicial ABERTA\", () => pm.expect(o.status).to.eql(\"ABERTA\"));",
              "pm.test(\"prazo = abertura + 4 h (SLA CRITICA)\", () => {",
              "  const horas = (new Date(o.prazo) - new Date(o.aberta_em)) / 3600000;",
              "  pm.expect(horas).to.eql(4);",
              "});",
              "pm.test(\"vinculada ao cliente\", () => pm.expect(o.cliente_id).to.eql(Number(pm.collectionVariables.get(\"clienteId\"))));",
              "pm.collectionVariables.set(\"ordemId\", o.id);"
            ]
          }
        }
