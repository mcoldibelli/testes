    {
      "name": "API-05 Criar cliente válido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Gera um CPF válido e fictício a cada execução, para o teste poder ser repetido.",
              "function dv(base) {",
              "  let soma = 0;",
              "  for (let i = 0; i < base.length; i++) soma += Number(base[i]) * (base.length + 1 - i);",
              "  const resto = soma % 11;",
              "  return resto < 2 ? 0 : 11 - resto;",
              "}",
              "let base = \"\";",
              "for (let i = 0; i < 9; i++) base += Math.floor(Math.random() * 10);",
              "if (/^(\\d)\\1+$/.test(base)) base = \"123456780\";",
              "let cpf = base + dv(base);",
              "cpf += dv(cpf);",
              "pm.collectionVariables.set(\"cpf\", cpf);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"contrato: campos e tipos\", () => {",
              "  pm.expect(c.id).to.be.a(\"number\");",
              "  pm.expect(c.nome).to.eql(\"Cliente Postman\");",
              "  pm.expect(c.criado_em).to.be.a(\"string\");",
              "});",
              "pm.test(\"CPF gravado só com dígitos\", () => pm.expect(c.cpf).to.eql(pm.collectionVariables.get(\"cpf\")));",
              "pm.test(\"e-mail normalizado em minúsculas\", () => pm.expect(c.email).to.eql(\"cliente.postman@teste.local\"));",
              "pm.collectionVariables.set(\"clienteId\", c.id);"
            ]
          }
        }
      ],
